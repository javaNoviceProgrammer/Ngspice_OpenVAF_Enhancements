//  VerilogA Un-Grammar.
//
// This grammar specifies the structure of VerilogA's concrete syntax tree.
// It does not specify parsing rules (ambiguities, precedence, etc are out of scope).
// Tokens are processed -- contextual keywords are recognised, compound operators glued.
//
// Legend:
//
//   //          -- comment
//   Name =      -- non-terminal definition
//   'ident'     -- token (terminal)
//   A B         -- sequence
//   A | B       -- alternation
//   A*          -- zero or more repetition
//   A?          -- zero or one repetition
//   (A)         -- same as A
//   label:A     -- suggested name for field of AST node

//*************************//
// Names, Paths and Macros //
//*************************//


Name = 'ident'
NameRef = 'ident'

Path =
  (qualifier:Path '.')? ('ident' | 'root')

AttrList =
  '(*' (Attr (',' Attr)*)? '*)'



Attr =
 Name ('=' val:Expr)?

Type = ('integer' | 'real' | 'string')

//****************************//
// Statements and Expressions //
//****************************//

Stmt =
EmptyStmt
| AssignStmt
| ExprStmt
| IfStmt
| WhileStmt
| DoWhileStmt
| RepeatStmt
| ForStmt
| CaseStmt
| EventStmt
| BlockStmt
| DisableStmt

EmptyStmt = AttrList* ';'

// `disable <block>;` (LRM 5.4) -- Verilog-A's loop/block early exit.
DisableStmt =
  AttrList* 'disable' Name

ExprStmt =
  AttrList* Expr ';'?

AssignStmt =
  AttrList* Assign ';'?

Assign =
  lval: Expr op: ('<+' | '=' | ':') rval: Expr

IfStmt =
  AttrList* 'if' '(' condition:Expr ')'
  then_branch: Stmt
  ('else' else_branch: Stmt)?

WhileStmt =
  AttrList* 'while' '(' condition:Expr ')'
  body: Stmt

DoWhileStmt =
  AttrList* 'do' body:Stmt 'while' '(' condition:Expr ')' ';'

RepeatStmt =
  AttrList* 'repeat' '(' count:Expr ')'
  body: Stmt

ForStmt =
  AttrList* 'for' '(' init: Stmt ';' condition:Expr ';' incr: Stmt ')'
  for_body: Stmt

CaseStmt =
  AttrList* 'case' '(' discriminant: Expr ')'
  Case*
  'endcase'

Case =
  (Expr (',' Expr)* | 'default') ':'? Stmt




// `@(initial_step)`/`@(final_step)` (optionally with an analysis-phase
// filter, e.g. `@(initial_step("dc", "ac"))`), or -- new in Enhancement-8 --
// `@(cross(expr, dir))`/`@(above(expr))`/`@(timer(t0, period))`, an ordinary
// `Expr` (always a `Call`, per the LRM, since `cross`/`above`/`timer` are
// only ever legal in this exact position -- see
// `hir_def::body::lower::collect_event_stmt`, which recognizes them by name
// rather than materializing them as a general builtin/function call).
EventStmt =
  AttrList* '@' '(' (('initial_step' | 'final_step') ('(' sim_phases: ('str_lit' (',' 'str_lit')*) ')')? | condition: Expr) ')' Stmt


BlockStmt =
  AttrList* 'begin'
    BlockScope?
    items: BlockItem*
  'end'

BlockScope = ':' Name

BlockItem = 
  VarDecl | ParamDecl | Stmt

Expr =
  Literal
| PrefixExpr
| BinExpr
| ParenExpr
| ArrayExpr
| Call
| SelectExpr
| BitSelectExpr
| PathExpr
| PortFlow
| ConcatExpr
| ReplicationExpr


PathExpr = Path // Required to allow
BitSelectExpr = base: Path ('[' index: Expr ']')*
PortFlow = '<' port: Path '>'

SelectExpr =
  condition: Expr '?' then_val: Expr ':' else_val: Expr

ArrayExpr =
  '\'{' (Expr (',' Expr)*)? '}'

// `{a, b, c}` -- Verilog-A concatenation (Enhancement-34).
ConcatExpr =
  '{' exprs:Expr* '}'

// `{n{a, b}}` -- replication (Enhancement-34). `count` is the repetition count
// and `elems` the replicated operands; both are plain child expressions, so the
// generated `elems` must skip the count.
ReplicationExpr =
  '{' count:Expr elems:Expr* '}'

Literal =
   'int_number' | 'str_lit' | 'std_real_number' | 'si_real_number' | 'inf'
   

PrefixExpr =
  AttrList* op:( '-' | '!' | '~' | '+') Expr

BinExpr =
  lhs:Expr
  op:(
    '||' | '&&'
  | '==' | '!=' | '<=' | '>=' | '<' | '>'
  | '+' | '*' | '-' | '/' | '**'
  | '%' | '<<' | '>>' | '<<<' | '>>>' | '^' | '^~' | '~^' | '|' | '&'
  )
  rhs:Expr

ParenExpr =
  '(' Expr ')'

ArgList =
  '(' args: (Expr (',' Expr)*)? ')'

Call =
  FunctionRef ArgList?

SysFun = 'sysfun'

FunctionRef =
  Path | SysFun

//*************************//
//          Items          //
//*************************//


SourceFile =
  Item*

Item =
   DisciplineDecl | NatureDecl | ModuleDecl | ParamsetDecl

DisciplineDecl =
  AttrList* 'discipline' Name ';'
  DisciplineAttr*
  'enddiscipline'

DisciplineAttr = 
  name: Path  '='? val:Expr ';'

NatureDecl =
  AttrList* 'nature' Name (':' parent: Path)? ';'
  NatureAttr*
  'endnature'

NatureAttr =
  Name '=' val: Expr ';'

ModuleDecl =
  AttrList* 'module' Name ModulePorts? ';'
   ModuleItem*
  'endmodule'

ModuleItem =
  BodyPortDecl
| NetDecl
| AnalogBehaviour
| Function
| BranchDecl
| VarDecl
| ParamDecl
| AliasParam
| Instantiation
| GenvarDecl
| GenerateFor
| GenerateIf
| GenerateCase

ModulePorts = '('ports: (ModulePort (',' ModulePort)*)? ')'
ModulePort = kind: ModulePortKind
ModulePortKind = PortDecl| Name

AnalogBehaviour =
  AttrList* 'analog' 'initial'? Stmt

VarDecl =
  AttrList* Type width:Range* (Var (',' Var)*) ';'

Var =
  Name width:Range* ('=' default:Expr)?



ParamDecl =
  AttrList* ('parameter'|'localparam') Type? width:Range* paras:(Param (',' Param)*) ';'

AliasParam =
  AttrList* 'aliasparam' name: Name '=' src: ParamRef ';'

ParamRef =
  Path | SysFun

Param = Name width:Range* '=' default:Expr Constraint*

Constraint =
    ('from' | 'exclude') (Expr | Range)

Range =
  ('(' | '[') start: Expr ':' end:Expr (')' | ']')


NetDecl =
  AttrList*  discipline:NameRef?  'net_type'? width:Range? (Name (',' Name)*)';'

BodyPortDecl =
  PortDecl ';'

PortDecl =
  AttrList* Direction discipline:NameRef?  'net_type'? width:Range? (Name (',' Name)*)

Direction =
  'inout' | 'input' | 'output'


// `analog function real[0:n] f;` -- the optional `[msb:lsb]` clauses before the
// name are the ARRAY RETURN dimensions (Enhancement-23), one per dimension.
Function =
  AttrList* 'analog' 'function' Type? width:Range* Name ';'
  FunctionItem*
  'endfunction'

FunctionItem =
  ParamDecl | VarDecl | FunctionArg | Stmt

// The `Type?` is Enhancement-389's COMBINED declaration `input real x;`; the
// separated form `input x; real x;` leaves it absent and takes its type from the
// matching variable declaration. An ANSI header entry `f(input real x)` produces
// this same node.
FunctionArg =
  AttrList* Direction Type? (Name(',' Name)*)';'



BranchDecl =
  AttrList* 'branch' ArgList (Name (',' Name)*)';'

// Sub-module instantiation, e.g. `resistor #(.r(1e3)) r1(in, out);`
// or an instance array `resistor #(.r(1e3)) r[0:3](p, gnd);`.
Instantiation =
  AttrList* module:NameRef ParamOverrides?
  (InstanceUnit (',' InstanceUnit)*) ';'

ParamOverrides =
  '#' '(' (ParamAssign (',' ParamAssign)*)? ')'

ParamAssign =
  ('.' name:Name '(' val:Expr ')') | val:Expr

InstanceUnit =
  name:Name width:Range? PortConns

PortConns =
  '(' (PortConn (',' PortConn)*)? ')'

// A single port actual. Named (`.p(net)`), positional (`net`), or entirely
// empty (an open/unconnected port, e.g. the middle slot in `inst(a, , c)`).
PortConn =
  ('.' name:Name '(' net:Expr ')') | net:Expr

// `genvar i, j;` -- declares one or more compile-time-only loop variables,
// only ever legal as the loop variable of a `GenerateFor`. Dropped entirely
// by elaboration (see `openvaf/hir/src/elaborate.rs`); never reaches
// `hir_def`.
GenvarDecl =
  AttrList* 'genvar' (Name (',' Name)*) ';'

// `generate for (i = 0; i < N; i = i + 1) begin : label ... end endgenerate`
// -- structural/declarative-only generation (LRM: no `analog` blocks may
// appear inside). `init`/`incr` reuse the ordinary `Assign` statement grammar
// (`i = 0`, `i = i + 1`); the loop bound (`N`, or any expression on either
// side of `condition`) must constant-fold to an integer at compile time --
// see `NonConstantGenerateBound` in `hir_def::item_tree`.
// `generate if (c) <block> else <block>` and `generate case` -- structural
// selection resolved at elaboration time, so their bodies are `GenerateBlock`s
// of module items rather than statements.
GenerateIf =
  AttrList* 'if' condition:Expr blocks:GenerateBlock* 'else'

GenerateCase =
  AttrList* 'case' discriminant:Expr arms:GenerateCaseArm*

GenerateCaseArm =
  'default' vals:Expr* block:GenerateBlock

// `paramset <name> <module>; ... endparamset` -- a named parameter preset for a
// module, selectable from the netlist.
ParamsetDecl =
  AttrList* 'paramset' Name target:NameRef
    param_decls:ParamDecl*
    overrides:ParamsetOverride*
  'endparamset'

ParamsetOverride =
  name:NameRef '=' val:Expr ';'

GenerateFor =
  AttrList* 'generate'
    'for' '(' init: Assign ';' condition: Expr ';' incr: Assign ')'
    body: GenerateBlock
  'endgenerate'

// The `begin : label ... end` body of a `generate for` loop. Unlike an
// ordinary `BlockStmt`, its items are `ModuleItem`s (structural/declarative
// only -- nets, instances, vars, params), not statements; a named label is
// required (LRM) so per-iteration instance/net names can be disambiguated
// (`r` -> `r_0`, `r_1`, ...) the same way an instance-array element already
// is (see `Enhancement-5.md`).
GenerateBlock =
  'begin' ':' label:Name
    items: ModuleItem*
  'end'
