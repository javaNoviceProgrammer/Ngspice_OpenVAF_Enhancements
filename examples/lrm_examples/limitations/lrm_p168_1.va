// Verilog-AMS LRM 2023 (Accellera), example from page 168
// extracted by lrm_examples/extract_lrm_examples.py (block_168_1)
`include "disciplines.vams"
`include "constants.vams"
    module adc (in, out);
       parameter bits=8, fullscale=1.0, dly=0.0, ttime=10n;
       input in;
       output [0:bits-1] out;
       electrical in;
       electrical [0:bits-1] out;
       real sample, thresh;
       genvar i;
       analog begin
          thresh = fullscale/2.0;
          sample = V(in);
       end
       generate
          for (i=bits-1; i>=0; i=i-1)
             analog begin
                V(out[i]) <+ transition(sample > thresh, dly, ttime);
                if (sample > thresh) sample = sample - thresh;
                sample = 2.0*sample;
             end
       endgenerate
    endmodule
