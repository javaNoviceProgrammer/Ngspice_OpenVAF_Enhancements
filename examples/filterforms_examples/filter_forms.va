// ---------------------------------------------------------------------------
// zi3: conj pole pair
// ---------------------------------------------------------------------------
module zi3_nd(a, c, o);
    inout a, c, o;
    electrical a, c, o;
    analog I(o,c) <+ V(o,c) - (zi_nd(V(a,c), '{1.0}, '{1.0, -0.8, 0.25}, 1e-06, 0.0));
endmodule

module zi3_np(a, c, o);
    inout a, c, o;
    electrical a, c, o;
    analog I(o,c) <+ V(o,c) - (zi_np(V(a,c), '{1.0}, '{0.4, 0.3, 0.4, -0.3}, 1e-06, 0.0));
endmodule

module zi3_zd(a, c, o);
    inout a, c, o;
    electrical a, c, o;
    analog I(o,c) <+ V(o,c) - (zi_zd(V(a,c), '{}, '{1.0, -0.8, 0.25}, 1e-06, 0.0));
endmodule

module zi3_zp(a, c, o);
    inout a, c, o;
    electrical a, c, o;
    analog I(o,c) <+ V(o,c) - (zi_zp(V(a,c), '{}, '{0.4, 0.3, 0.4, -0.3}, 1e-06, 0.0));
endmodule

