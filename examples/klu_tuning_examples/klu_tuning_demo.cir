r59 n_3_6 n_3_7 100
r60 n_3_7 n_4_7 100
r61 n_4_0 n_5_0 100
r62 n_4_0 n_4_1 100
r63 n_4_1 n_5_1 100
r64 n_4_1 n_4_2 100
r65 n_4_2 n_5_2 100
r66 n_4_2 n_4_3 100
r67 n_4_3 n_5_3 100
