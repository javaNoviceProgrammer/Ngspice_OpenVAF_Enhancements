r39 n_2_4 n_3_4 100
r40 n_2_4 n_2_5 100
r41 n_2_5 n_3_5 100
r42 n_2_5 n_2_6 100
r43 n_2_6 n_3_6 100
r44 n_2_6 n_2_7 100
r45 n_2_7 n_3_7 100
r46 n_3_0 n_4_0 100
r47 n_3_0 n_3_1 100
r48 n_3_1 n_4_1 100
r49 n_3_1 n_3_2 100
r50 n_3_2 n_4_2 100
r51 n_3_2 n_3_3 100
