r110 n_7_4 n_7_5 100
r111 n_7_5 n_7_6 100
r112 n_7_6 n_7_7 100

.control
  set numdgt=12

  echo --- default KLU (amd ordering, max scaling, BTF on) ---
  option klu
  op
  print v(n_2_3)

  echo --- COLAMD ordering + sum scaling, BTF off ---
  option klu klu_ordering=colamd klu_scale=sum klu_btf=off
  reset
  op
  print v(n_2_3)
.endc
.end
